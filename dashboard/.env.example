# Credenciais para o painel ler as tabelas gold ao vivo no Databricks.
# Copie para .env.local e preencha. Sem elas, o painel usa o snapshot em src/data/snapshot.json.
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SCHEMA=workspace.agrosmart
